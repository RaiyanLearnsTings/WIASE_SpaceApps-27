# WIASE static demo on Apache shared hosting (e.g. GoDaddy cPanel).
# Browsers refuse ES modules served with the wrong MIME type, so declare it explicitly.
AddType text/javascript .mjs .js
AddType model/gltf-binary .glb
AddType application/json .json
AddType image/svg+xml .svg
DirectoryIndex index.html

<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/css text/javascript application/javascript application/json model/gltf-binary image/svg+xml
</IfModule>

<IfModule mod_headers.c>
  <FilesMatch "\.(glb|json)$">
    Header set Cache-Control "public, max-age=3600"
  </FilesMatch>
  Header always set X-Content-Type-Options "nosniff"
</IfModule>
